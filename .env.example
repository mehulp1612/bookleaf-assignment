# Copy to .env at the repository root. Set DATABASE_URL locally; never commit it.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
WEB_PORT=5173
APP_ORIGIN=http://localhost:5173
DATABASE_URL=
# Local Docker PostgreSQL. Choose a password and use the same values in DATABASE_URL:
# postgresql://<POSTGRES_USER>:<url-encoded-password>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>
POSTGRES_DB=bookleaf
POSTGRES_USER=bookleaf
POSTGRES_PORT=5433
POSTGRES_PASSWORD=
LOG_LEVEL=info
SESSION_TTL_SECONDS=28800
# Explicit demo seed configuration; never use personal account passwords.
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=
DEMO_AUTHOR_PASSWORD=
# Only set true when intentionally rotating demo passwords and revoking their sessions.
DEMO_RESET_PASSWORDS=false
# Optional M05 AI services; M06 will connect these to ticket jobs and draft endpoints.
# Never use a VITE_ prefix for credentials. Restart after changes. No automatic model fallback.
AI_PROVIDER=disabled
# Use openrouter or compatible when enabling; compatible requires an explicit HTTPS API base.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Choose explicit model IDs supported by your provider/account. No model is selected silently.
AI_CLASSIFICATION_MODEL=
AI_DRAFT_MODEL=
# prompt works without native structured outputs; all outputs still undergo Zod validation.
# Alternatives: json_object or json_schema, only if supported by the selected models.
AI_OUTPUT_MODE=prompt
AI_TIMEOUT_MS=20000
AI_CLASSIFICATION_MAX_TOKENS=400
AI_DRAFT_MAX_TOKENS=1200
# M06 runner runs alongside the API. Limits and pauses are shared through PostgreSQL.
AI_WORKER_ENABLED=true
AI_JOB_POLL_MS=1000
AI_CONCURRENCY=1
AI_REQUESTS_PER_MINUTE=6
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_MS=2000
