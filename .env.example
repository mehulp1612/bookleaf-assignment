# Copy to .env at the repository root. Set DATABASE_URL locally; never commit it.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
WEB_PORT=5173
APP_ORIGIN=http://localhost:5173
DATABASE_URL=
# Local Docker PostgreSQL. Choose a password and use the same values in DATABASE_URL:
# postgresql://<POSTGRES_USER>:<url-encoded-password>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>
POSTGRES_DB=bookleaf
POSTGRES_USER=bookleaf
POSTGRES_PORT=5433
POSTGRES_PASSWORD=
LOG_LEVEL=info
SESSION_TTL_SECONDS=28800
# Explicit demo seed configuration; never use personal account passwords.
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=
DEMO_AUTHOR_PASSWORD=
# Only set true when intentionally rotating demo passwords and revoking their sessions.
DEMO_RESET_PASSWORDS=false
# AI providers and credentials are introduced in M05, not needed for M01.
