// M02 owns identity; M03 owns Author metadata and Book.
generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AUTHOR
  ADMIN
}

model Author {
  id         String    @id
  name       String?
  email      String?
  phone      String?
  city       String?
  joinedDate DateTime? @db.Date
  user       User?
  books      Book[]
}

model Book {
  id                        String    @id
  authorId                  String
  author                    Author    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title                     String
  isbn                      String
  genre                     String
  publicationDate           DateTime? @db.Date
  status                    String
  mrpPaise                  BigInt?
  authorRoyaltyPerCopyPaise  BigInt?
  totalCopiesSold           Int
  totalRoyaltyEarnedPaise    BigInt
  royaltyPaidPaise           BigInt
  royaltyPendingPaise        BigInt
  lastRoyaltyPayoutDate      DateTime? @db.Date
  printPartner              String?
  availableOn               String[]

  @@index([authorId, id])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  displayName  String
  passwordHash String
  role         Role
  authorId     String?   @unique
  author       Author?   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  sessions     Session[]
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
}

model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model LoginThrottle {
  key       String   @id
  attempts  Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}
