{
  "name": "@bookleaf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently -k -n compiler,server \"tsc -b tsconfig.json --watch --preserveWatchOutput\" \"node --watch --watch-preserve-output dist/index.js\"",
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node dist/seed.js",
    "db:import": "node dist/import-catalog.js"
  },
  "dependencies": {
    "@bookleaf/contracts": "*",
    "fastify": "^5.0.0",
    "@fastify/static": "^8.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.0.0",
    "dotenv": "^17.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "prisma": "^7.0.0",
    "@types/pg": "^8.0.0"
  }
}
